# --- LLM / Azure OpenAI (Member 4, used inside llm-service) ---
CV_SCORING_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<paste-from-team-lead>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# --- Azure Blob Storage (Member 3, used inside backend for file uploads) ---
# This must point at OUR storage account, not Inteltion's company account.
AZURE_STORAGE_CONNECTION_STRING=<paste-full-connection-string-here>
AZURE_STORAGE_CONTAINER_NAME=resumes
# Guardrail: the account name we expect the connection string above to contain.
# Mismatch = the backend refuses to start rather than writing CVs (personal
# data, PDPA) into the wrong subscription. GET /health shows which is live.
AZURE_STORAGE_ACCOUNT_NAME=<our-storage-account-name>
COMPANY_STORAGE_ACCOUNT_NAME=
ALLOW_COMPANY_STORAGE=false

# --- Backend ---
DATABASE_URL=postgresql://inteltion:inteltion@localhost:5432/inteltion_mvp
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# First admin account, seeded only while the hr_accounts table is empty.
# Change SEED_ADMIN_PASSWORD before this touches real data.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<set-a-real-password>
SEED_ADMIN_EMAIL=admin@inteltion.local
SEED_ADMIN_FULL_NAME=<your name>
JWT_SECRET=<a-long-random-string>

# --- Frontend (Vite exposes only VITE_-prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=true