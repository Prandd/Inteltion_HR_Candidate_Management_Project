{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inteltion.local/contracts/candidate.schema.json",
  "title": "Candidate",
  "description": "FROZEN CONTRACT for the Inteltion HR 7-day MVP. Every API 'data' payload for a single candidate matches this shape exactly. NULL RULE: there are no nulls anywhere - a missing string is \"\", a missing number is 0, a missing array is []. Every property is always present. Mirrored in code as backend/app/schemas.py (Pydantic) and to be mirrored as frontend/components/types.ts (TypeScript).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "full_name",
    "email",
    "phone",
    "location",
    "applied_position",
    "summary",
    "skills",
    "experience",
    "experience_total",
    "current_salary",
    "expected_salary",
    "education",
    "hr_comment",
    "line_manager_comment",
    "extraction_confidence",
    "raw_text_snippet",
    "status",
    "resume_url",
    "resume_filename",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "UUID, generated by the backend. Read-only. Ignored if sent in a PUT/upload body."
    },
    "full_name": { "type": "string" },
    "email": { "type": "string", "description": "Not format-validated on extraction; PUT rejects a value with no '@'." },
    "phone": { "type": "string" },
    "location": {
      "type": "string",
      "description": "PROPOSED ADDITION vs the Member 3 doc schema - present in the master plan and CapstoneMeeting.md. City, country / 'Remote'."
    },
    "applied_position": { "type": "string", "description": "e.g. 'Senior Backend Engineer'." },
    "summary": { "type": "string", "description": "Short bio / objective, 1-3 sentences." },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "tools"],
        "properties": {
          "skill": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "position", "start_date", "end_date", "description"],
        "properties": {
          "company": { "type": "string" },
          "position": { "type": "string" },
          "start_date": { "type": "string", "description": "'YYYY-MM' | 'Present' | ''" },
          "end_date": { "type": "string", "description": "'YYYY-MM' | 'Present' | ''" },
          "description": { "type": "string" }
        }
      }
    },
    "experience_total": { "type": "number", "description": "Total years of professional experience." },
    "current_salary": { "type": "number", "description": "Monthly THB. 0 = not provided / unknown." },
    "expected_salary": { "type": "number", "description": "Monthly THB. 0 = not provided / unknown." },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution", "degree", "field", "year"],
        "properties": {
          "institution": { "type": "string" },
          "degree": { "type": "string" },
          "field": { "type": "string" },
          "year": { "type": "string" }
        }
      }
    },
    "hr_comment": { "type": "string", "description": "Filled by HR in the dashboard. Empty from extraction." },
    "line_manager_comment": { "type": "string", "description": "Filled by the hiring manager. Empty from extraction." },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "0 when unknown."
    },
    "raw_text_snippet": { "type": "string", "description": "Debug only. First ~500 chars of parsed CV text." },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Review",
        "Needs information",
        "CV passed",
        "Assessment",
        "Interview",
        "Hired",
        "CV rejected",
        "Archived"
      ],
      "description": "PROPOSED ADDITION - pipeline status from CapstoneMeeting.md. Defaults to 'New' on upload."
    },
    "resume_url": { "type": "string", "description": "Read-only. Link to the stored original file ('' if none)." },
    "resume_filename": { "type": "string", "description": "Read-only. Original filename ('' if none)." },
    "created_at": { "type": "string", "description": "ISO 8601. Read-only, server-generated." },
    "updated_at": { "type": "string", "description": "ISO 8601. Read-only, server-generated." }
  },
  "$defs": {
    "candidateSummary": {
      "title": "CandidateSummary",
      "description": "Shape returned by GET /api/candidates (list view). Derived from Candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "full_name",
        "applied_position",
        "location",
        "email",
        "phone",
        "experience_total",
        "status",
        "top_skills",
        "extraction_confidence",
        "created_at"
      ],
      "properties": {
        "candidate_id": { "type": "string" },
        "full_name": { "type": "string" },
        "applied_position": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "experience_total": { "type": "number" },
        "status": { "type": "string" },
        "top_skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Up to 5 skill names, flattened from skills[].skill."
        },
        "extraction_confidence": { "type": "number" },
        "created_at": { "type": "string" }
      }
    },
    "responseEnvelope": {
      "title": "ResponseEnvelope",
      "description": "Every endpoint returns this. success: {data: <payload>, error: null}. failure: {data: null, error: <message>}.",
      "type": "object",
      "required": ["data", "error"],
      "properties": {
        "data": {},
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
