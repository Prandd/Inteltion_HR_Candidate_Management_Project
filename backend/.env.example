# Copy to backend/.env for local `uvicorn` runs.
# Every value below is already the default - the mock backend runs fine with NO .env file.

DATABASE_URL=sqlite:///./data/dev.db
UPLOAD_DIR=./data/uploads
SEED_FILE=../shared-contracts/mock-candidates.json
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=10

