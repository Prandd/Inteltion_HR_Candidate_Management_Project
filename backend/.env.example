# Copy to backend/.env for local `uvicorn` runs.
# Every value below is already the default - the mock backend runs fine with NO .env file.

DATABASE_URL=sqlite:///./data/dev.db
UPLOAD_DIR=./data/uploads
SEED_FILE=../shared-contracts/mock-candidates.json
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=10

# ---- Auth. HR accounts live in the `hr_accounts` table now (round 4).
# These three bootstrap the FIRST admin, and ONLY while that table is empty -
# they are not a login path. Everyone else is created through
# POST /api/hr-accounts. The app logs a warning on startup while the password
# below is still the default. ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_EMAIL=admin@inteltion.local
SEED_ADMIN_FULL_NAME=Seed Admin

JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=480

# ---- Login hardening ----
MIN_PASSWORD_LENGTH=8
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# ---- File storage. Leave AZURE_STORAGE_CONNECTION_STRING empty (the default)
# to keep using local disk - zero setup. A real deployment sets these in the
# SERVER's .env only; never commit real values here. ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=resumes
RESUME_SAS_EXPIRY_MINUTES=60

# ---- Which storage account is OURS, and which one is the company's.
#
# There are two Azure accounts in play:
#   * OURS      - the account the team provisioned and controls. Everything in
#                 dev and staging must land here.
#   * COMPANY   - Inteltion's own account. We do not have access yet, and
#                 nothing should be written there until they grant it.
#
# AZURE_STORAGE_ACCOUNT_NAME is the account we EXPECT the connection string to
# point at. If it names a different account, the app refuses to start instead of
# quietly writing CVs (personal data, PDPA) into the wrong subscription.
# Check which one is live at any time with GET /health -> data.storage.account.
AZURE_STORAGE_ACCOUNT_NAME=
# Set this to the company's account name to get a clearer error if a stray .env
# ever points there, and set ALLOW_COMPANY_STORAGE=true only once they have
# actually granted us access.
COMPANY_STORAGE_ACCOUNT_NAME=
ALLOW_COMPANY_STORAGE=false

