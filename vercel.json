{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "llm-service", "format": "url", "env": "LLM_SERVICE_URL" }
      ]
    },
    "dashboard": {
      "root": "frontend/dashboard",
      "framework": "vite"
    },
    "llm-service": {
      "root": "llm-service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}
